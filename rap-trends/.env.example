# =============================================================================
# RAP TRENDS — environment variables
#
# NOTHING here is required to run the demonstration build. Every integration
# degrades to the seeded dataset rather than failing, which is deliberate: the
# product should be walkable end to end without a single credential.
#
# Full documentation: docs/18-setup-and-deployment.md
# =============================================================================

# ---- Core -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "demo" or "live". Drives the site-wide demonstration banner and the dataMode
# field on every API response. Set to "live" ONLY when the data really is live —
# this flag is the promise the product makes about honesty.
RAPTRENDS_DATA_MODE=demo

# ---- Database (Phase 1) -----------------------------------------------------
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Object storage ---------------------------------------------------------
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=

# ---- Google Drive ingestion -------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Newlines escaped as \n
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_ARTICLES_FOLDER_ID=
GOOGLE_DRIVE_VIDEOS_FOLDER_ID=
GOOGLE_DRIVE_SWEEP_MINUTES=5

# ---- Index sources ----------------------------------------------------------
# A missing credential means the source stays pending_agreement: it contributes
# nothing to any score and lowers the published confidence figure instead of
# being estimated. That behaviour is the point, not a limitation.
INDEX_STREAMING_API_KEY=
INDEX_VIDEO_API_KEY=
INDEX_AIRPLAY_API_KEY=
INDEX_SHAZAM_API_KEY=
INDEX_SOCIAL_API_KEY=
INDEX_SHORTFORM_API_KEY=
INDEX_TICKETING_API_KEY=

# ---- Playout and distribution ----------------------------------------------
PLAYOUT_VENDOR=
PLAYOUT_API_URL=
PLAYOUT_API_KEY=
SSAI_ENDPOINT=
SSAI_API_KEY=
EPG_PUBLISH_URL=

# ---- AI services ------------------------------------------------------------
# Every output is a draft requiring human review. Unreviewed captions are
# blocked from delivery by the rights gate.
AI_TRANSCRIPTION_API_KEY=
AI_METADATA_API_KEY=

# ---- Email and notifications ------------------------------------------------
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
SMS_API_KEY=
ALERT_PHONE_NUMBERS=

# ---- Observability ----------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info
